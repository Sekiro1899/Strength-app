# ─────────────────────────────────────────────────────────────
# Laisser ce fichier VIDE (ou ne pas créer de .env) fait démarrer
# l'app en MODE DÉMO : tout le flux fonctionne en local, sans
# Supabase ni FastAPI. Idéal pour itérer sur les écrans.
# ─────────────────────────────────────────────────────────────

# Supabase — auth + CRUD standard
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# FastAPI — uniquement /workout/generate et /feedback/redirect
EXPO_PUBLIC_API_URL=https://your-backend.railway.app

# Forcer le mode démo même avec des identifiants renseignés
# EXPO_PUBLIC_DEMO_MODE=1
